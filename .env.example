# =====================================================================
#  qualisira-licences — variables d'environnement
# =====================================================================
#
#  À recopier en « .env » (non versionné) ou à injecter par le
#  gestionnaire de secrets. Les valeurs ci-dessous sont des EXEMPLES :
#  aucune n'est un secret réel.
#
#  Les valeurs par défaut du code visent le poste de développement. Sur
#  une installation livrée, tout ce qui est marqué OBLIGATOIRE doit être
#  posé — sans quoi le service démarrera avec des réglages de portable.
#
# =====================================================================


# ---------------------------------------------------------------------
#  1. LA CLÉ DE SIGNATURE — à lire avant tout le reste
# ---------------------------------------------------------------------
#
#  Ce fichier porte la clé privée qui signe TOUTES les licences.
#
#  CONSÉQUENCE POUR LE DÉPLOIEMENT : il doit vivre sur un volume
#  PERSISTANT, monté au même endroit à chaque version. Un conteneur qui
#  repart sur un disque vide n'a plus de clé — et le service REFUSE alors
#  de démarrer, au lieu d'en engendrer une nouvelle en silence. C'est
#  voulu : une clé remplacée rend invérifiables toutes les licences déjà
#  remises aux clients, sans message d'erreur ici. Un démarrage qui échoue
#  se remarque dans la minute ; une clé perdue, jamais.
#
#  À SAUVEGARDER comme un certificat de signature. Sa perte oblige à
#  réémettre le parc entier ; sa divulgation permet d'émettre sans limite.
#
#  Le dossier doit être accessible en écriture au compte du service.
#
LICENCES_CLES=/var/lib/qualisira-licences/cles-editeur.properties

#  PREMIÈRE INSTALLATION SEULEMENT — engendrer la paire de clés.
#
#  Laissez « false » en fonctionnement normal. La marche à suivre, une
#  fois le volume ci-dessus monté :
#
#    1. LICENCES_ENGENDRER_CLES=true, puis démarrer le service ;
#    2. relever la clé publique — elle est annoncée dans le journal de ce
#       démarrage-là, et se relit ensuite sur /actuator/info, qui demande
#       d'être connecté (seul /actuator/health est ouvert) ;
#    3. la poser dans le produit : QUALISIRA_CLE_PUBLIQUE=<la clé>
#       (referentiel-service), puis redémarrer celui-ci ;
#    4. sauvegarder le fichier de clés hors de la machine ;
#    5. remettre LICENCES_ENGENDRER_CLES=false.
#
#  L'étape 3 n'est pas optionnelle : referentiel-service REFUSE de démarrer
#  sans cette variable, qui n'a plus de valeur par défaut. C'est voulu —
#  la clé du poste de développement y figurait, et un oubli à la livraison
#  faisait refuser toutes les licences réelles pour « signature invalide »,
#  sans que rien ne relie la panne à sa cause.
#
LICENCES_ENGENDRER_CLES=false


# ---------------------------------------------------------------------
#  2. BASE DE DONNÉES — OBLIGATOIRE
# ---------------------------------------------------------------------
#
#  Flyway applique les migrations au démarrage : le compte doit pouvoir
#  créer et modifier des tables, pas seulement lire et écrire.
#
#  Une base déjà en service est marquée « baseline v1 » sans être
#  rejouée ; une base vide reçoit tout l'historique.
#
LICENCES_DB_URL=jdbc:postgresql://bdd.interne:5432/qualisira_licencesdb
LICENCES_DB_USER=qualisira_licences
LICENCES_DB_MDP=                      # SECRET — depuis le coffre


# ---------------------------------------------------------------------
#  3. SERVICE
# ---------------------------------------------------------------------
LICENCES_PORT=8099

#  Durée d'inactivité avant fermeture de session.
LICENCES_SESSION_DUREE=8h

#  OBLIGATOIRE derrière HTTPS : sans « true », le cookie de session
#  circule aussi en clair, et une interception suffit à voler la session.
LICENCES_COOKIE_SECURE=true

#  Le back-office, servi par ce même service : une seule origine, donc
#  pas de CORS, pas de relais à configurer, et une adresse de retour vers
#  Keycloak qu'aucun intermédiaire n'a pu réécrire.
#
#  Y déposer le contenu de « dist/backoffice-licences/browser » du dépôt
#  du front. Le front se met ainsi à jour sans reconstruire le serveur.
#
#  Vide, les fichiers sont cherchés dans le jar (classpath:/static/).
LICENCES_FRONT=/var/www/backoffice-licences

#  Ne sert QUE si le front est servi depuis une autre origine — ce que le
#  montage ci-dessus évite. Énumérées, jamais « * » : la session
#  accompagne chaque appel.
LICENCES_CORS=


# ---------------------------------------------------------------------
#  4. AUTHENTIFICATION
# ---------------------------------------------------------------------
#
#  « keycloak » en fonctionnement normal ; « local » pour un poste hors
#  réseau — émettre une licence ne doit pas dépendre de la disponibilité
#  du serveur d'identité.
#
LICENCES_AUTH=keycloak

#  Variables préfixées KC_LICENCES_ et NON les KC_ habituelles : les
#  autres services QualiSira partagent KC_ISSUER_URI / KC_CLIENT_ID /
#  KC_CLIENT_SECRET pour le royaume « quali ». Reprendre ces noms ferait
#  démarrer cet outil avec le secret d'un autre client, et échouer à
#  l'échange du code — longtemps après le démarrage.
KC_LICENCES_ISSUER=https://identite.qualisira.com/realms/qualisira-licences
KC_LICENCES_CLIENT=qualisira-licences
KC_LICENCES_SECRET=                   # SECRET — depuis le coffre

#  Rôle du royaume exigé pour entrer. Il n'accorde AUCUNE permission :
#  chaque compte porte aussi son rôle métier (SUPER_ADMIN, EDITEUR,
#  LECTEUR), sans quoi l'application s'ouvre sur des actions refusées.
#
#  À créer dans le royaume, avec les mappeurs « realm roles » et
#  « client roles » cochés « Add to ID token » — sans cela l'utilisateur
#  arrive sans aucun rôle et personne n'entre.
LICENCES_ROLE=LICENCES_EDITEUR


# ---------------------------------------------------------------------
#  5. PREMIER COMPTE
# ---------------------------------------------------------------------
#
#  Ouvert au tout premier démarrage, et jamais rouvert ensuite : en mode
#  « local » dans la base, en mode « keycloak » dans le royaume.
#
LICENCES_ADMIN_UTILISATEUR=admin
LICENCES_ADMIN_NOM=Super administrateur

#  OÙ PARTENT LES ACCÈS. Le mot de passe est envoyé à cette adresse
#  plutôt qu'affiché : sur une installation livrée, le journal du premier
#  démarrage part dans un collecteur que personne ne lit à cet instant
#  précis, et le mot de passe s'y perd. Il reste annoncé dans le journal
#  si l'envoi échoue — d'où l'intérêt de régler le SMTP (§ 6) AVANT le
#  premier démarrage.
#
#  Sans cette adresse, aucun compte n'est ouvert en mode Keycloak :
#  personne ne pourrait en recevoir les accès.
#
#  LA BOÎTE DOIT EXISTER. Une adresse plausible mais non ouverte ne se
#  voit pas au démarrage : le serveur SMTP l'accepte, puis la refuse à la
#  remise (« 550 Mailbox does not exist »), et les accès repartent dans
#  le journal. Vérifié : « licences@qualisira.com » n'est PAS une boîte.
LICENCES_ADMIN_EMAIL=

#  LAISSER VIDE de préférence : un mot de passe est alors tiré au hasard.
#  Dans les deux cas il ne vaut que pour la première connexion, son
#  changement étant réclamé avant toute autre action.
LICENCES_ADMIN_MDP=

#  Adresse publique du back-office, pour que le courriel porte un lien
#  cliquable. Au démarrage, aucune requête n'est encore arrivée : il n'y
#  a rien d'où la déduire. Vide, le message reste juste, il n'y manque
#  que le lien.
LICENCES_URL=https://licence-app.qualisira.com

#  MODE KEYCLOAK — ouvrir le premier compte DANS le royaume au démarrage,
#  avec le rôle d'entrée et SUPER_ADMIN, puis lui envoyer ses accès.
#  Rien n'est fait si un compte porte déjà le rôle d'entrée.
#
#  À PESER AVANT DE LAISSER « true » : cela demande d'activer le compte
#  de service du client et de lui donner « manage-users » et
#  « manage-realm ». Un client autorisé à créer des comptes dans le
#  royaume peut s'en créer un — sur un royaume PARTAGÉ, cette portée
#  dépasse largement cet outil. « false » pour créer le premier compte à
#  la main depuis la console, ce qui reste le choix le plus sobre.
LICENCES_ADMIN_PROVISION=true

#  Pour ne pas donner ce droit au client que rencontrent les utilisateurs,
#  désigner ici un client distinct. Vides, c'est KC_LICENCES_CLIENT qui
#  sert.
KC_LICENCES_ADMIN_CLIENT=
KC_LICENCES_ADMIN_SECRET=              # SECRET — depuis le coffre


# ---------------------------------------------------------------------
#  6. COURRIEL — remise des licences aux partenaires
# ---------------------------------------------------------------------
#
#  Sans mot de passe, l'envoi échoue au moment de remettre une licence,
#  pas au démarrage : le message d'erreur reprend la cause donnée par le
#  serveur SMTP, et la licence reste téléchargeable depuis l'écran.
#
MAIL_HOST=mail.qualisira.com
MAIL_PORT=465
MAIL_USERNAME=noreply@qualisira.com
MAIL_PASSWORD=                        # SECRET — depuis le coffre

#  Expéditeur affiché, s'il diffère du compte SMTP.
#  UNE ADRESSE, pas un libellé : cette valeur devient l'en-tête « From ».
#  Un simple nom — « L'équipe QualiSira » — est refusé avant même que le
#  serveur SMTP soit contacté, et PLUS AUCUN courriel ne part : ni les
#  licences, ni les accès du premier compte. La forme « Nom <adresse> »
#  ou l'adresse nue sont les deux seules acceptées.
LICENCES_EXPEDITEUR=QualiSira Licences <noreply@qualisira.com>

#  Rien de commercial ne se règle plus par variable : la durée d'un essai,
#  ses modules et son plafond d'utilisateurs sont ceux de l'offre marquée
#  « essai » au catalogue, et se modifient depuis l'écran des offres.
