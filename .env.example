# =====================================================================
#  qualisira-licences — variables d'environnement
# =====================================================================
#
#  À recopier en « .env » (non versionné) ou à injecter par le
#  gestionnaire de secrets. Les valeurs ci-dessous sont des EXEMPLES :
#  aucune n'est un secret réel.
#
#  Les valeurs par défaut du code visent le poste de développement. Sur
#  une installation livrée, tout ce qui est marqué OBLIGATOIRE doit être
#  posé — sans quoi le service démarrera avec des réglages de portable.
#
# =====================================================================


# ---------------------------------------------------------------------
#  1. LA CLÉ DE SIGNATURE — à lire avant tout le reste
# ---------------------------------------------------------------------
#
#  Ce fichier porte la clé privée qui signe TOUTES les licences. Il est
#  engendré au premier démarrage s'il n'existe pas.
#
#  CONSÉQUENCE POUR LE DÉPLOIEMENT : il doit vivre sur un volume
#  PERSISTANT, monté au même endroit à chaque version. Un conteneur qui
#  repart sur un disque vide engendre une NOUVELLE paire de clés, et
#  toutes les licences déjà remises aux clients deviennent invérifiables
#  — sans message d'erreur ici : c'est chez le client que ça casse.
#
#  À SAUVEGARDER comme un certificat de signature. Sa perte oblige à
#  réémettre le parc entier ; sa divulgation permet d'émettre sans limite.
#
#  Le dossier doit être accessible en écriture au compte du service.
#
LICENCES_CLES=/var/lib/qualisira-licences/cles-editeur.properties


# ---------------------------------------------------------------------
#  2. BASE DE DONNÉES — OBLIGATOIRE
# ---------------------------------------------------------------------
#
#  Flyway applique les migrations au démarrage : le compte doit pouvoir
#  créer et modifier des tables, pas seulement lire et écrire.
#
#  Une base déjà en service est marquée « baseline v1 » sans être
#  rejouée ; une base vide reçoit tout l'historique.
#
LICENCES_DB_URL=jdbc:postgresql://bdd.interne:5432/qualisira_licencesdb
LICENCES_DB_USER=qualisira_licences
LICENCES_DB_MDP=                      # SECRET — depuis le coffre


# ---------------------------------------------------------------------
#  3. SERVICE
# ---------------------------------------------------------------------
LICENCES_PORT=8099

#  Durée d'inactivité avant fermeture de session.
LICENCES_SESSION_DUREE=8h

#  OBLIGATOIRE derrière HTTPS : sans « true », le cookie de session
#  circule aussi en clair, et une interception suffit à voler la session.
LICENCES_COOKIE_SECURE=true

#  Origines du back-office, énumérées et jamais « * » : la session
#  accompagne chaque appel. Plusieurs origines se séparent par une virgule.
LICENCES_CORS=https://licences.qualisira.com


# ---------------------------------------------------------------------
#  4. AUTHENTIFICATION
# ---------------------------------------------------------------------
#
#  « keycloak » en fonctionnement normal ; « local » pour un poste hors
#  réseau — émettre une licence ne doit pas dépendre de la disponibilité
#  du serveur d'identité.
#
LICENCES_AUTH=keycloak

#  Variables préfixées KC_LICENCES_ et NON les KC_ habituelles : les
#  autres services QualiSira partagent KC_ISSUER_URI / KC_CLIENT_ID /
#  KC_CLIENT_SECRET pour le royaume « quali ». Reprendre ces noms ferait
#  démarrer cet outil avec le secret d'un autre client, et échouer à
#  l'échange du code — longtemps après le démarrage.
KC_LICENCES_ISSUER=https://identite.qualisira.com/realms/qualisira-licences
KC_LICENCES_CLIENT=qualisira-licences
KC_LICENCES_SECRET=                   # SECRET — depuis le coffre

#  Rôle du royaume exigé pour entrer. Il n'accorde AUCUNE permission :
#  chaque compte porte aussi son rôle métier (SUPER_ADMIN, EDITEUR,
#  LECTEUR), sans quoi l'application s'ouvre sur des actions refusées.
#
#  À créer dans le royaume, avec les mappeurs « realm roles » et
#  « client roles » cochés « Add to ID token » — sans cela l'utilisateur
#  arrive sans aucun rôle et personne n'entre.
LICENCES_ROLE=LICENCES_EDITEUR


# ---------------------------------------------------------------------
#  5. PREMIER COMPTE — mode « local » uniquement
# ---------------------------------------------------------------------
#
#  Créé au tout premier démarrage, et jamais recréé ensuite. En mode
#  Keycloak, aucun compte local n'est créé : ces variables sont inertes.
#
LICENCES_ADMIN_UTILISATEUR=admin
LICENCES_ADMIN_NOM=Super administrateur
LICENCES_ADMIN_EMAIL=licences@qualisira.com

#  LAISSER VIDE de préférence : un mot de passe est alors tiré au hasard
#  et annoncé UNE SEULE FOIS dans le journal du premier démarrage.
#  Prévoir de le relever à ce moment — il n'est plus affiché ensuite.
LICENCES_ADMIN_MDP=


# ---------------------------------------------------------------------
#  6. COURRIEL — remise des licences aux partenaires
# ---------------------------------------------------------------------
#
#  Sans mot de passe, l'envoi échoue au moment de remettre une licence,
#  pas au démarrage : le message d'erreur reprend la cause donnée par le
#  serveur SMTP, et la licence reste téléchargeable depuis l'écran.
#
MAIL_HOST=mail.qualisira.com
MAIL_PORT=465
MAIL_USERNAME=noreply@qualisira.com
MAIL_PASSWORD=                        # SECRET — depuis le coffre

#  Expéditeur affiché, s'il diffère du compte SMTP.
LICENCES_EXPEDITEUR=QualiSira <licences@qualisira.com>


# ---------------------------------------------------------------------
#  7. COMMERCIAL
# ---------------------------------------------------------------------
#  Durée de la licence d'essai, en jours.
LICENCES_ESSAI_JOURS=7
